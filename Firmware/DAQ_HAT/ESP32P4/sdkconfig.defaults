CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# SILICON REVISION — the fabricated DAQ HAT uses ESP32-P4 rev v1.3 (esp32p4-eco2),
# which is PRE-rev3 and uses the SPLIT SRAM layout (sram_low/sram_high). Select the
# rev<3.0 support branch with a v1.0 minimum (covers v1.3). This MUST stay in
# lockstep with board_build.chip_variant = esp32p4_es in platformio.ini (the
# builder's split sections.ld.in). Using REV_MIN_301 (rev3 contiguous) here
# crashes v1.3 silicon with an illegal-instruction Guru Meditation at boot.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# Custom dual-OTA partition table (partitions.csv) for safe A/B firmware update.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# Rollback: a freshly OTA'd app boots PENDING_VERIFY and must self-confirm with
# esp_ota_mark_app_valid_cancel_rollback(); otherwise the bootloader reverts.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Reject an image whose secure-version is older (anti-downgrade), see version.h.
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=n
# PSRAM — used for the ADAQ sample ring buffers (DMA-into-PSRAM data path).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n

# Allow placing the DRDY ISR in IRAM.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# The DRDY-gated ADAQ capture tasks are pinned to CPU1 (dedicated acquisition
# core). Under load they legitimately run at 100% and starve CPU1's IDLE task;
# that is expected here, so do NOT let it trip the task watchdog and reboot.
# (CPU0 IDLE stays watched — it runs USB/DSP/links and must stay responsive.)
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Finer scheduler granularity (1 ms tick) so a brief capture-task yield doesn't
# cost 10 ms of throughput at 100 Hz.
CONFIG_FREERTOS_HZ=1000

# Per-task CPU accounting for the `perf` CLI command. The pipeline's two hot
# loops both busy-poll, so "is a core saturated?" cannot be answered by eye —
# it needs real per-task run-time shares. The esp_timer source costs one 64-bit
# timer read per context switch, which is negligible next to the ~128 k
# samples/s the pipeline is already moving.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# -O2 rather than the IDF default -Og. Measured on hardware with the `perf`
# profiler at the saturation point (odr ratio 32): 405 kSPS -> 443 kSPS
# aggregate, +9.2%, with per-stage costs down 13-18% across the board
# (cap.scan -18.2%, fast.loop -17.2%). Both hot loops are hand-written C on a
# 360 MHz RISC-V core with no DMA, so they are exactly the shape -O2 helps
# most. It is also SMALLER here: 1101942 B flash vs 1115446 B, 16560 B RAM vs
# 17144 B. Revert to CONFIG_COMPILER_OPTIMIZATION_DEBUG only if step-debugging.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# TinyUSB — USB-HS vendor-bulk endpoint for the measurement data stream (J5).
# Vendor class enabled by setting the interface count > 0. Large TX FIFO for
# high-throughput streaming; 512-byte endpoints (HS bulk max packet).
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=512
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=32768
CONFIG_TINYUSB_VENDOR_EPSIZE=512

# Console routing. The P4 MUST boot independently of any USB connection. The
# empirically-confirmed blocking stage is the 2nd-stage BOOTLOADER: when its
# console is the USB-Serial-JTAG, its early writes spin on the TX FIFO until a
# host drains it, so the chip hangs in the bootloader until the debug port is
# plugged. The APP-level USB-JTAG console is already non-blocking (drops after
# ~50 ms when no host), so silencing just the bootloader lets the device boot
# with nothing attached while keeping the interactive REPL + all logs on the
# convenient USB debug port (COMxx). See daq_cli_start.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Silence the 2nd-stage bootloader so it never blocks on an unplugged USB-JTAG.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0
# Enable the SDIO port in esp-serial-flasher for C6 in-system programming.
CONFIG_SERIAL_FLASHER_PORT_SDIO=y
# Give the C6 SDIO slave 800 ms to initialize after RST release before the
# first sdio_card_init attempt (default 50 ms is too short for the ROM slave).
CONFIG_SERIAL_FLASHER_BOOT_HOLD_TIME_MS=800
# ESP-Hosted: C6 acts as the WiFi radio co-processor for the P4 (which has no
# radio of its own) over the existing SDIO pins (config.h C6_SDIO_*). Every
# other option (SDIO transport, slot 1, 4-bit bus, and per-pin GPIO numbers)
# already defaults to exactly this board's wiring for a plain ESP32-P4 host
# (CMD19/CLK18/D0-3=14-17, reset=54 -- verified against
# managed_components/espressif__esp_hosted/Kconfig) once the co-processor
# target is picked; only the target itself has no default and must be set.
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
# Default is ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP: esp_wifi_init()
# unconditionally hard-resets the C6 via its CHIP_PU-adjacent GPIO before
# even attempting SDIO, wiping all C6 RAM state -- including a DDP
# wifi_stream_mode flag/wifi_hosted_start() call the P4 sent moments earlier
# to get the C6 ready, which is exactly backwards for our "tell C6 first,
# then bring up the host side" sequencing (daq_board.c's
# HATP_CMD_DAQ_WIFI_STREAM_START handler). ONLY_IF_NECESSARY only resets if
# the SDIO handshake actually fails, so a C6 that's already running its
# hosted stack (told via DDP over the separate UART2 link, unaffected by
# this GPIO) is left alone and just answers over SDIO directly.
CONFIG_ESP_HOSTED_SLAVE_RESET_ONLY_IF_NECESSARY=y
CONFIG_ESP_HOSTED_HOST_RESTART_NO_COMMUNICATION_WITH_SLAVE=y
# Retry a failed flash-data block up to 8 times (default 3) before aborting the
# whole C6 transfer. The P4<->C6 UART link at 115200 occasionally glitches on a
# single block; each retry re-syncs SLIP framing and re-sends the block, so more
# retries let a transient recover instead of killing a 375 KB flash mid-stream.
# Worst case 8 x DEFAULT_TIMEOUT (1 s) = 8 s per block, well under the host's
# 35 s per-chunk ACK deadline in flash_via_p4.py.
CONFIG_SERIAL_FLASHER_WRITE_BLOCK_RETRIES=8
