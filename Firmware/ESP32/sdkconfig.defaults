# ESP-IDF SDK Configuration for BugBuster AD74416H Controller

# Console: NONE - we handle USB CDC ourselves via TinyUSB
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_USB_CDC is not set
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# TinyUSB: dual CDC (CLI + UART bridge), pinned to Core 0 (with WiFi/network)
# Frees Core 1 for real-time SPI measurement tasks
CONFIG_TINYUSB=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y
CONFIG_TINYUSB_TASK_AFFINITY=0x0

# SPIFFS support
CONFIG_SPIFFS_MAX_PARTITIONS=3

# OTA rollback: if new firmware crashes before confirming, bootloader reverts
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# app_main initializes WiFi, hardware, MicroPython, and the large HTTP route
# table before handing off to long-lived tasks. Keep enough stack headroom for
# ESP-IDF route registration and diagnostic coredump reporting during boot.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# SPI flash — ESP32-S3 N16R8 module: 16 MB flash + 8 MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Octal PSRAM (AP_Memory APS6408L-OBM or compatible, 64 Mb = 8 MB)
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Enable the .ext_ram.bss linker section so that EXT_RAM_BSS_ATTR on
# file-scope variables actually places them in PSRAM (without this, the
# section size stays 0 even when the attribute is applied correctly).
# The symbol is ..._EXTERNAL_MEMORY on this IDF; a bare CONFIG_SPIRAM_ALLOW_BSS_SEG
# sat here for a while and matched nothing, so the setting survived only in the
# generated sdkconfig - meaning a clean CI build had it OFF while local
# incremental builds had it ON.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Internal-heap budgeting (root-cause fix for `mainLoopTask creation failed`
# / `Failed to start HTTP server: ESP_ERR_HTTPD_TASK` crashes seen 2026-05-07):
# the previous 16384 threshold meant every cJSON node, http buffer, and
# transient malloc < 16 KB landed in internal SRAM, fragmenting the 32 KB
# reserve pool to the point where xTaskCreate could not find a contiguous
# 4 KB stack block (observed: free=4863 / largest=3328 immediately before
# mainLoopTask). Drop ALWAYSINTERNAL so only allocations < 1 KB stay
# internal-first, and raise RESERVE so the internal pool keeps a floor for
# FreeRTOS task TCBs/stacks and DMA buffers. Verified safe: every explicit
# heap_caps_malloc in src/ already pins to MALLOC_CAP_SPIRAM.
#
# Confirmed load-bearing 2026-05-07 (second pass): bumping ALWAYSINTERNAL
# back to the IDF default 16384 reproduces the httpd-start failure
# (internal_free=4467 / largest=2304 before webserver). The runtime
# alloc-noise log lines (mdns_send / i2c_master_start / esp_partition_mmap
# NO_MEM) are the price we pay; they're cosmetic — those subsystems still
# function — and chasing them by raising ALWAYSINTERNAL breaks the web
# server, which is not an acceptable trade.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152

# mDNS small allocations (e.g. 176 B RX buffers) spill to PSRAM when the
# internal pool is exhausted post-webserver. Internal-only mDNS produced
# `mdns_send: Cannot allocate memory` / `mdns_networking: Cannot allocate
# memory (receive(176))` noise after httpd init drained internal heap.
# httpd's task stack stays internal via httpd_config_t.task_caps; WiFi/DMA
# allocations stay internal via explicit MALLOC_CAP_DMA|INTERNAL flags.
# MDNS_MEMORY_ALLOC_* is a Kconfig *choice*, so clearing INTERNAL on its own
# does nothing - the choice just falls back to its default, which is INTERNAL.
# That is why the PSRAM spill described above never actually happened. Select
# SPIRAM positively instead. (Found by Firmware/tools/check_sdkconfig_effective.py.)
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# WiFi buffer tuning — BugBuster is a bench instrument, not a media server.
# Static TX/RX buffers live in internal DMA RAM regardless of SPIRAM_USE_MALLOC.
# Cutting TX from 16→6 and RX from 16→8 frees ~28 KB of scarce internal DMA RAM.
# CACHE_TX_BUFFER_NUM (dynamic PSRAM) stays at 32 to absorb burst headroom.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# WiFi Rate Adaptation tuning — PSRAM now handles HTTP buffers, so WiFi
# can use full management buffer pool without competing for internal RAM.
CONFIG_ESP_WIFI_ENABLE_WIFI6=y
# Keep management buffer pool at default (32) — HTTP buffers moved to PSRAM
# eliminates internal RAM contention.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
# Improve RX aggregation window for better efficiency
# Kconfig caps ESP_WIFI_RX_BA_WIN at 2 * ESP_WIFI_STATIC_RX_BUFFER_NUM, which is
# 16 here, so the 32 this line used to request was silently clamped to 16 and had
# no effect. Raising it for real would mean more internal DMA RAM for static RX
# buffers, which this build does not have spare - so state the value we actually
# get. (Found by Firmware/tools/check_sdkconfig_effective.py.)
CONFIG_ESP_WIFI_RX_BA_WIN=16

# Cache: bump with octal PSRAM (default 16 KB/32 KB is too small for external RAM workloads)
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

# LWIP: raise socket limit so the httpd can open max_open_sockets=10 connections.
# httpd reserves 3 sockets internally; 10 + 3 = 13, so 16 gives comfortable headroom.
# Default LWIP_MAX_SOCKETS=7 is too small for SSE streaming + concurrent REST polls.
CONFIG_LWIP_MAX_SOCKETS=16

# WebSocket support in esp_http_server (required for /api/scripts/repl/ws)
CONFIG_HTTPD_WS_SUPPORT=y

# NOTE: httpd's max URI handler count is NOT a Kconfig option (esp_http_server's
# Kconfig only exposes HTTPD_MAX_REQ_HDR_LEN/HTTPD_MAX_URI_LEN/etc — no handler-count
# knob exists). It is the runtime httpd_config_t.max_uri_handlers field, set in
# webserver.cpp at httpd_start(). See that file for the real fix + route count.

# HTTPS/GitHub update checks need a full TLS handshake while the firmware is
# already running WiFi, TinyUSB, MicroPython, BBP, and HTTPD. Keep the TLS
# buffers in PSRAM instead of consuming scarce contiguous internal heap.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
# Hardware AES requires DMA-capable internal RAM for its GDMA buffers even when
# MBEDTLS_EXTERNAL_MEM_ALLOC=y. The 49 KB internal reserve is depleted by
# WiFi/SPI DMA by the time an HTTPS connection fires, causing esp-aes OOM.
# Software AES uses the normal PSRAM-backed allocator — acceptable for the
# infrequent firmware-update path.
# CONFIG_MBEDTLS_HARDWARE_AES is not set

# Diagnostic crash capture: store panic core dumps in the flash coredump partition.
# This avoids relying on TinyUSB CDC surviving long enough to print Guru Meditation logs.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32

# Stack overflow detection — writes canary words at the bottom of every task
# stack and validates them on every context switch. Overflow triggers abort()
# which saves a core dump to flash (see CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH).
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# =============================================================================
# Bluetooth LE (NimBLE) — low-rate control plane for the iOS app.
#
# Purpose: out-of-box WiFi provisioning + supply control + sensor readout over
# BLE, so a phone can talk to the device before it is on the LAN. This is NOT a
# streaming path (no scope/LA/DAQ over BLE) — payloads are tiny, so we keep the
# stack lean to protect the already-tight internal DMA SRAM reserve documented
# above (the httpd start-up failure mode).
#
# S3 = BLE 5.0 peripheral only. NimBLE host (smaller than Bluedroid), single
# connection (the product pairs to exactly one phone), peripheral role only —
# no central/observer/scan code linked in.
# =============================================================================
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Single bonded central — the device is paired to one phone.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Peripheral + broadcaster only; drop central/observer to save flash + RAM.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
# Bonding/LE Secure Connections so the pairing token isn't re-sent every session.
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
# One bond record is enough for a single-phone product.
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=4
# Host task stack — keep modest; GATT callbacks here are short.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
# Allocate NimBLE host memory pools (mbufs, GATT tables) from PSRAM rather than
# internal DRAM. The BLE controller layer still claims ~60 KB of internal heap
# (unavoidable on S3), but the host layer (~8-15 KB) moves to PSRAM.
# Requires CONFIG_SPIRAM_USE_MALLOC=y (already set above).
# CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
