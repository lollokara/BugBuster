{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bugbuster",
  "version": "2.1.0",
  "identifier": "com.bugbuster",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": ".."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "trunk build",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BugBuster",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyRTA3MjVBMTRERDM5NTEKUldSUk9kMFVXbkxnNHFQNGFTTVZiQlMrS05hR1QvaGtkNVJCUmI3aHFGcHA4aC9ZTytvQVBMM1IK",
      "endpoints": [
        "https://github.com/lollokara/BugBuster/releases/latest/download/bugbuster-desktop-update-manifest.json",
        "https://github.com/lollokara/BugBuster/releases/download/nightly/bugbuster-desktop-update-manifest.json"
      ],
      "dialog": false
    }
  }
}
