# =============================================================================
# BugBuster .gitignore
# =============================================================================

# macOS
.DS_Store
**/.DS_Store
._*
**/._*

# Altium Designer version history (auto-generated backups)
History/
__Previews/

# ESP-IDF / PlatformIO build artifacts
Firmware/esp32_ad74416h/.pio/
Firmware/esp32_ad74416h/managed_components/espressif__tinyusb
Firmware/esp32_ad74416h/managed_components/espressif__esp_tinyusb
Firmware/esp32_ad74416h/sdkconfig.esp32s3
Firmware/esp32_ad74416h/firmware_ota.bin

# Rust / Tauri build artifacts
DesktopApp/BugBuster/target/
DesktopApp/BugBuster/dist/
DesktopApp/BugBuster/notebook-run-logs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv-*/
**/.venv/
*.egg-info/

# Test outputs & reports
Scripts/*.csv
tests/.report.json
tests/report.html
test-results/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.xcuserstate

# Jupyter
.ipynb_checkpoints/
/Firmware/RP2040/build
/Firmware/RP2040/build-local-*/
/DesktopApp/BugBuster/tests/e2e/node_modules

# AI / Tooling state
.omc/
.omx/
.omg/
CLAUDE.md
AGENTS.md

# Logs and artifacts
*.log
build_log.txt
*.orig
*.rej

# Scratch and reproduction scripts
scratch/
Scripts/scratch_*
Diag/repro_*

/DesktopApp/BugBuster/.omc
/Firmware/RP2040/.omc
/DesktopApp/BugBuster/src-tauri/.omc
/Firmware/ESP32/managed_components
/Firmware/ESP32/.omc
/Firmware/ESP32/src/mp/.omc
/Firmware/ESP32/web/.omc
/Scripts/logs
/Docs/superpowers
/iOSApp/.omc
/Firmware/ESP32/src/.omc
iOSApp/bugbuster.xcodeproj/project.xcworkspace/xcuserdata/lorenzo.xcuserdatad/UserInterfaceState.xcuserstate
Scripts/clean-appledouble.sh

# -----------------------------------------------------------------------------
# Additional common build / tool caches to keep out of the repo
# -----------------------------------------------------------------------------

# PlatformIO global artifacts (catch other firmware folders)
**/.pio/
**/.pioenvs/

# Pico/CMake local build directories
**/build-*/
**/build/

# Python test / typecheck caches
.pytest_cache/
.mypy_cache/
.cache/

# Node / JS artifacts
node_modules/
npm-debug.log*
yarn-error.log*

# Rust/Cargo workspace target
/target/

# Misc IDE / editor
*.code-workspace

# Mex project folder (optional internal tool) — avoid accidentally committing
.mex/
.superpowers/
